{{ .XMLHeader -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ .BaseURL }}/</loc>
  </url>
  {{- range $id, $doc := .Docs }}
  <url>
    <loc>{{ $.BaseURL }}/{{ $id }}.html</loc>
    {{- if $doc.Meta.date }}
    <lastmod>{{ $doc.Meta.date }}</lastmod>
    {{- end }}
  </url>
  {{- end }}
</urlset>
