{{ .XMLHeader -}}
<rss version="2.0">
<channel>
<title>{{ .BaseURL }}</title>
<link>{{ .BaseURL }}/</link>
<description>The dated pages of {{ .BaseURL }}</description>
{{- range $id, $doc := .Docs }}{{ with $doc.Meta.date }}
<item>
<title>{{ $doc.Title }}</title>
<link>{{ $.BaseURL }}/{{ $id }}.html</link>
<guid>{{ $.BaseURL }}/{{ $id }}.html</guid>
<pubDate>{{ rfc822 . }}</pubDate>
</item>
{{- end }}{{ end }}
</channel>
</rss>
