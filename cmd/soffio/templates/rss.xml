{{ .XMLHeader -}}
<rss version="2.0">
  <channel>
    <title>Soffio Site</title>
    <link>{{ .BaseURL }}</link>
    <description>A static site generated by Soffio.</description>
    {{- range $id, $doc := .Docs }}
    <item>
      <title>{{ $doc.Title }}</title>
      <link>{{ $.BaseURL }}/{{ $id }}.html</link>
      <guid>{{ $.BaseURL }}/{{ $id }}.html</guid>
      {{- if $doc.Meta.description }}
      <description>{{ $doc.Meta.description }}</description>
      {{- end }}
      {{- if $doc.Meta.date }}
      <pubDate>{{ $doc.Meta.date }}</pubDate>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
